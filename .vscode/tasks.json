{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Luma: One-time owner signing setup (NO PASTE)",
      "type": "shell",
      "command": "bash",
      "args": [
        "android-tv/setup-signing.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "echo": false,
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "default",
        "instanceLimit": 1
      }
    }
  ]
}
