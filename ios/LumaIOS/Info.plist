<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>Luma</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>UILaunchScreen</key><dict/>
  <key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>NSAppTransportSecurity</key><dict>
    <!-- Native URLSession and AVPlayer need explicit HTTP approval for owner-provided IPTV.
         Unlike Safari's HTTPS mixed-content policy, a native signed app can opt in.
         Broad ATS exceptions require careful security review and an App Store justification.
         No service credentials are stored in this source file or uploaded to Luma. -->
    <key>NSAllowsArbitraryLoads</key><true/>
  </dict>
</dict></plist>
